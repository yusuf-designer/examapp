# Copy this file to a new file called .env and fill it in. Never share the .env file or put it online.

# Reading and grading with Mistral (https://console.mistral.ai > API keys)
MISTRAL_API_KEY=
# Optional. The grading model and the page-reading model.
MISTRAL_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Where the data lives. Leave both empty to keep data in a file on this computer (data/store.json).
# From Supabase: Project Settings > API Keys > Secret keys > default (starts with sb_secret_). It is a secret.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional. The port the app opens on.
PORT=5174

# Optional. Use Claude instead of Mistral by leaving MISTRAL_API_KEY empty and filling this.
ANTHROPIC_API_KEY=
